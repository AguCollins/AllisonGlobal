# ============================================================
#  Allison Global — .gitignore
# ============================================================

# ─── Secrets & Environment ─────────────────────────────────
# NEVER commit .env files with real credentials
.env
.env.local
.env.production
.env.*.local
# .env.example IS committed (contains no secrets — just variable names)

# ─── Database ───────────────────────────────────────────────
# SQLite local dev database (do not commit)
db/
*.db
*.db-journal
*.sqlite

# Prisma migrations (commit these — they define the schema history)
!prisma/migrations/

# ─── Dependencies ──────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js ────────────────────────────────────────────────
/.next/
/out/
/build/
/.next/standalone/

# ─── Build artifacts ────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Logs ───────────────────────────────────────────────────
*.log
dev.log
server.log
prod.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── OS files ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ─── Uploads & temp files ──────────────────────────────────
upload/
tmp/
temp/

# ─── IDE / Editor ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Vercel ────────────────────────────────────────────────
.vercel

# ─── Claude / AI config (sandbox-only) ─────────────────────
.claude
.z-ai-config
.zscripts/

# ─── Skills (sandbox-only) ─────────────────────────────────
/skills/
/examples/
/tests/
/mini-services/
/tool-results/
/download/
/prompt

# ─── Misc ──────────────────────────────────────────────────
local-*
