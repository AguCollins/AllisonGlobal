# ============================================================
#  Allison Global — Environment Variables
#  ─────────────────────────────────────────────────────────
#  Copy this file to .env.local and fill in real values.
#  NEVER commit .env.local with real credentials.
#  This file contains ONLY variable names — no secrets.
# ============================================================

# ─── Database (Neon PostgreSQL) ────────────────────────────
# Get this from https://console.neon.tech → your project → Dashboard → Connection string
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=""

# ─── Upstash Redis (rate limiting) ────────────────────────
# Get these from https://console.upstash.com → your database → REST API
# Required for production distributed rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── NextAuth (admin authentication) ──────────────────────
# Generate a random secret: run `openssl rand -base64 32`
NEXTAUTH_SECRET=""

# The canonical URL of your deployed app (no trailing slash)
NEXTAUTH_URL="https://www.allisonglobal.tech"

# ─── Public Site URL (SEO) ────────────────────────────────
# Used for metadataBase, sitemap, canonical URLs, Open Graph
NEXT_PUBLIC_SITE_URL="https://www.allisonglobal.tech"
